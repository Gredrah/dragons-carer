// ==UserScript==

// @name Dragon Care Revive Request Button

// @namespace http://tampermonkey.net/

// @version 1.0.0

// @author Gredra [1996198]

// @description Gredra [1996198]'s Dragon Care Revive Request Button | Primary buyer submission path for revive orders | Forked from Torn Wars Revive Request Button by YazanZed [3258052]

// @match https://www.torn.com/*

// @grant GM_xmlhttpRequest

// @grant GM_getValue

// @grant GM_setValue

// @license MIT

// ==/UserScript==



(function () {

    'use strict';

    const SCRIPT_VERSION = "1.0.0";
    const API_KEY_STORAGE_KEY = "torn_api_key";
    const API_KEY_URL = "https://www.torn.com/preferences.php#tab=api?step=addNewKey&title=ReviveStorefront-Reviver&user=basic,revivesfull,skills";

    // Buyers should submit revive orders here first; Discord remains the fallback/manual path.



    const getStoredApiKey = () => GM_getValue(API_KEY_STORAGE_KEY, null);

    const showKeySetup = () => {

        window.open(API_KEY_URL, "_blank", "noopener,noreferrer");

        const apiKey = prompt("Paste your Torn API key here after generating it. This will be saved locally for future revive requests:");

        if (!apiKey) {

            alert("No API key saved yet. Generate the key first, then return here and paste it once.");

            return null;

        }

        const normalized = apiKey.trim();

        if (!normalized) {

            alert("No API key saved yet. Generate the key first, then return here and paste it once.");

            return null;

        }

        GM_setValue(API_KEY_STORAGE_KEY, normalized);

        return normalized;

    };

    const handleButtonClick = () => {

        let apiKey = getStoredApiKey();

        const savedPrice = GM_getValue("revive_price", null);



        if (!apiKey) {

            apiKey = showKeySetup();

            if (!apiKey) {

                return;

            }

        }

        showPriceModal(apiKey, savedPrice);

    };



    const createHeaderBtn = (id) => {

        const hBtn = document.createElement('button');

        hBtn.textContent = "Request Care ??";

        hBtn.id = id;

        hBtn.style.cssText = `

margin-right: 10px;

margin-top: 2px;

padding: 0 10px;

height: 24px;

font-size: 11px;

font-weight: 600;

color: #fff;

background-color: #3498db;

border: none;

border-radius: 3px;

cursor: pointer;

line-height: 24px;

display: inline-flex;

align-items: center;

justify-content: center;

vertical-align: middle;

float: right;

flex-shrink: 0;

white-space: nowrap;

min-width: max-content;

`;

        hBtn.addEventListener('click', (e) => {

            e.preventDefault();

            handleButtonClick();

        });

        return hBtn;

    };



    const createGeneratorBtn = (id) => {

        const btn = document.createElement('button');

        btn.textContent = "Generate Care Key ??";

        btn.id = id;

        btn.style.cssText = `

margin-right: 10px;

margin-top: 2px;

padding: 0 10px;

height: 24px;

font-size: 11px;

font-weight: 600;

color: #fff;

background-color: #2ecc71;

border: none;

border-radius: 3px;

cursor: pointer;

line-height: 24px;

display: inline-flex;

align-items: center;

justify-content: center;

vertical-align: middle;

float: right;

flex-shrink: 0;

white-space: nowrap;

min-width: max-content;

`;

        btn.addEventListener('click', (e) => {

            e.preventDefault();

            handleButtonClick();

        });

        return btn;

    };



    const createSidebarButton = (hasApiKey) => {

        const btn = document.createElement('button');

        btn.id = hasApiKey ? 'dc-revive-btn' : 'dc-key-btn';
        btn.textContent = hasApiKey ? "Request Care ??" : "Generate Care Key ??";
        btn.style.cssText = hasApiKey
            ? "width:100%; margin-top:5px; padding:8px 0; font-size:12px; font-weight:600; color:#fff; background-color:#3498db; border:none; border-radius:4px; cursor:pointer; font-family:Arial, sans-serif; flex-shrink: 0;"
            : "width:100%; margin-top:5px; padding:8px 0; font-size:12px; font-weight:600; color:#fff; background-color:#2ecc71; border:none; border-radius:4px; cursor:pointer; font-family:Arial, sans-serif; flex-shrink: 0;";

        btn.addEventListener('click', handleButtonClick);
        return btn;

    };



    const injectButtons = () => {

        const hasApiKey = Boolean(getStoredApiKey());

        const outerWrap = document.querySelector('div[class^="account-links-wrap"]');

        if (outerWrap) {

            const existing = outerWrap.querySelector('#dc-revive-btn, #dc-key-btn');

            if (existing) {

                existing.remove();

            }

            outerWrap.style.display = "flex";

            outerWrap.style.flexDirection = "column";

            outerWrap.appendChild(createSidebarButton(hasApiKey));

        }



        const reviveLink = document.querySelector('.revive-availability-btn');

        if (reviveLink) {

            const existing = document.getElementById('dc-hospital-btn') || document.getElementById('dc-hospital-key-btn');

            if (existing) {

                existing.remove();

            }

            reviveLink.insertAdjacentElement('afterend', hasApiKey ? createHeaderBtn('dc-hospital-btn') : createGeneratorBtn('dc-hospital-key-btn'));

        }



        const warfareLink = document.querySelector('.view-wars');

        if (warfareLink) {

            const existing = document.getElementById('dc-faction-btn') || document.getElementById('dc-faction-key-btn');

            if (existing) {

                existing.remove();

            }

            warfareLink.insertAdjacentElement('afterend', hasApiKey ? createHeaderBtn('dc-faction-btn') : createGeneratorBtn('dc-faction-key-btn'));

        }

    };



    setInterval(injectButtons, 1000);



    function showPriceModal(apiKey, savedPrice) {

        const overlay = document.createElement('div');

        overlay.style.cssText = "position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:100000;";

        const modal = document.createElement('div');

        modal.style.cssText = "position:fixed; top:50%; left:50%; transform:translate(-50%, -50%); background:#fff; padding:20px; border-radius:8px; width:300px; color:#333; font-family:Arial;";



        modal.innerHTML = `

<label style="display:block; margin-bottom:6px; font-weight:600;">Payment Type:</label>

<select id="dc-type-select" style="width:100%; margin-bottom:12px;"><option value="Cash">Cash</option><option value="Xanax">Xanax</option></select>

<label style="display:block; margin-bottom:6px; font-weight:600;">Revive Price:</label>

<select id="dc-price-select" style="width:100%; margin-bottom:12px;"></select>

<label style="display:block; margin-bottom:6px; font-weight:600;">Required Revive Skill:</label>

<select id="dc-skill-select" style="width:100%; margin-bottom:12px;"><option>Any</option><option>At least 75%</option><option>Full (100%)</option></select>

<label style="display:flex; align-items:center; margin-bottom:12px;"><input type="checkbox" id="dc-save-price" style="margin-right:6px;"> Save this price</label>

<div style="text-align:center;"><button id="dc-send" style="padding:6px 12px; background:#3498db; color:#fff; border:none; border-radius:4px; cursor:pointer;">Send</button> <button id="dc-close" style="padding:6px 12px; background:#aaa; color:#fff; border:none; border-radius:4px; cursor:pointer;">Cancel</button></div>

`;



        document.body.appendChild(overlay);

        overlay.appendChild(modal);



        const typeS = modal.querySelector('#dc-type-select');

        const priceS = modal.querySelector('#dc-price-select');

        const skillS = modal.querySelector('#dc-skill-select');

        const update = () => {

            const isCash = typeS.value === "Cash";

            const skillVal = skillS.value;

            const requiresMin2 = skillVal === "At least 75%" || skillVal === "Full (100%)";

            const allOpts = isCash ? ["1m", "2m", "5m"] : ["1 Xanax", "2 Xanax", "5 Xanax"];

            const opts = requiresMin2 ? allOpts.slice(1) : allOpts;

            priceS.innerHTML = opts.map(o => `<option value="${o}">${o}</option>`).join('');

            if (savedPrice && opts.includes(savedPrice)) priceS.value = savedPrice;

        };

        typeS.onchange = update;

        skillS.onchange = update;

        update();



        modal.querySelector('#dc-send').onclick = () => {

            const data = { type: typeS.value, price: priceS.value, skill: modal.querySelector('#dc-skill-select').value };

            if (modal.querySelector('#dc-save-price').checked) GM_setValue("revive_price", data.price);

            sendToController(data, apiKey);

            document.body.removeChild(overlay);

        };

        modal.querySelector('#dc-close').onclick = () => document.body.removeChild(overlay);

    }



    function sendToController(data, apiKey) {

        GM_xmlhttpRequest({

            method: "POST",

            url: "https://torn-api.gredra.com/",

            headers: { "Content-Type": "application/json" },

            data: JSON.stringify({ apiKey, ...data, scriptVersion: SCRIPT_VERSION }),

            onload: (res) => console.log("Sent:", res)

        });

    }

})();
