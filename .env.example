# Discord bot token from the Discord Developer Portal
DISCORD_TOKEN=

# Guild (server) IDs for instant slash-command sync during development.
# Storefront = buyer-facing server. Ops = your mod/reviver server.
STOREFRONT_GUILD_ID=
OPS_GUILD_ID=
FORWARDING_GUILD_ID=

# Channel IDs
MOD_QUEUE_CHANNEL_ID=
REVIVER_PING_CHANNEL_ID=
FORWARDING_CHANNEL_ID=
OPS_CHANNEL_ID=

# Optional footer branding for the forwarded revive mirror.
FORWARDING_JOIN_LINK=

# Fernet key for encrypting stored Torn API keys at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DB_ENCRYPTION_KEY=

# Path to the SQLite database file
DB_PATH=revive_bot.db

# Optional revive pricing used by the UI panel.
STANDARD_REVIVE_PRICE=
T75_REVIVE_PRICE=
T100_REVIVE_PRICE=

# Timeouts (seconds)
CLAIM_TIMEOUT_SECONDS=300
DELIVERY_TIMEOUT_SECONDS=900
PAYMENT_WINDOW_SINGLE_SECONDS=900
PAYMENT_WINDOW_MULTI_SECONDS=3600
PAYMENT_DISPUTE_WINDOW_SECONDS=600

# Poller intervals (seconds)
LINKED_ROLE_SYNC_INTERVAL_HOURS=24
HOSPITAL_POLL_INTERVAL=150
TIMEOUT_SWEEP_INTERVAL=30
QUEUE_REASSIGN_INTERVAL=15
ACTIVE_ORDER_REMINDER_INTERVAL=300

# Discord/UI operational limits
DISCORD_MESSAGE_SOFT_LIMIT=1900
MODERATION_VIEW_TIMEOUT_SECONDS=300

# Torn API
TORN_API_TIMEOUT_SECONDS=10

# Assignment balancing knobs
ASSIGNMENT_DROUGHT_BONUS_PER_DAY=1.0
ASSIGNMENT_DROUGHT_BONUS_CAP=3.0
ASSIGNMENT_FAIRNESS_WINDOW_DAYS=7

# Debug-only override: when set to a non-zero Torn ID, outgoing revive
# verification is bypassed for orders from that buyer ID.
DEBUG_OUTGOING_REVIVE_BYPASS_TORN_ID=0
